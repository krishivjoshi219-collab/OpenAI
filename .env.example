# Runtime
APP_ENV=development
LOG_LEVEL=INFO

# Database: PostgreSQL in deployed environments; SQLite is supported for local development.
DATABASE_URL=sqlite:///./ai_operations_employee.db
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_operations_employee

# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini

# Telegram notifications (optional until notification workflows are added)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

