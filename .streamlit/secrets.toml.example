# ── Aster Ops · Streamlit Cloud Secrets ────────────────────────────────────
#
# Copy the keys you need into the Streamlit Community Cloud "Secrets" editor
# (App settings → Secrets).  Do NOT commit a real secrets.toml to git.
#
# Required for AI features:
GROQ_API_KEY = "gsk_..."
AI_PROVIDER  = "groq"
GROQ_MODEL   = "llama-3.3-70b-versatile"

# Optional — override the database (defaults to SQLite at /tmp/):
# DATABASE_URL = "postgresql+psycopg://user:pass@host/dbname"

# Optional — OpenAI fallback:
# OPENAI_API_KEY = "sk-..."

# Optional — Telegram notifications:
# TELEGRAM_BOT_TOKEN = "..."
# TELEGRAM_CHAT_ID   = "..."
